# GoreeCloud Swarm development-only service configuration.
# The service refuses non-loopback binds until authenticated remote management exists.
SWARM_LISTEN_ADDR=127.0.0.1:8080

# The default build keeps the transfer engine unavailable.
SWARM_ENGINE=unavailable

# A build compiled with -tags anacrolix_engine may use:
# SWARM_ENGINE=anacrolix
# SWARM_DOWNLOAD_DIR=/absolute/path/to/swarm-downloads
